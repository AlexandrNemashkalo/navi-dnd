diff --git a/alacritty/src/renderer/text/braille.rs b/alacritty/src/renderer/text/braille.rs
new file mode 100644
index 0000000..1c46ecd
--- /dev/null
+++ b/alacritty/src/renderer/text/braille.rs
@@ -0,0 +1,90 @@
+//! Font-independent 2x4 artwork pixels. No platform or GPU dependencies.
+
+pub fn cell_height(advance: f64, offset_x: i8, offset_y: i8) -> f64 {
+    (advance + f64::from(offset_x)).floor().max(1.) * 2. - f64::from(offset_y)
+}
+
+pub fn rasterize(character: char, width: usize, height: usize) -> Option<Vec<u8>> {
+    let mask = (character as u32).checked_sub(0x2800)?;
+    if mask > 255 {
+        return None;
+    }
+    let mut pixels = vec![0; width * height * 3];
+    // Unicode braille bit order: left 1,2,3,7; right 4,5,6,8.
+    let bits = [[0, 1, 2, 6], [3, 4, 5, 7]];
+    let pitch_x = width as f64 / 2.;
+    let pitch_y = height as f64 / 4.;
+    let half = pitch_x.min(pitch_y) / 3.;
+    for (column, rows) in bits.iter().enumerate() {
+        for (row, bit) in rows.iter().enumerate() {
+            if mask & (1 << bit) == 0 {
+                continue;
+            }
+            let cx = (column as f64 + 0.5) * pitch_x;
+            let cy = (row as f64 + 0.5) * pitch_y;
+            // Area coverage keeps half-pixel spacing uniform at odd cell widths.
+            for y in (cy - half).floor() as usize..((cy + half).ceil() as usize).min(height) {
+                for x in (cx - half).floor() as usize..((cx + half).ceil() as usize).min(width) {
+                    let dx = ((x + 1) as f64).min(cx + half) - (x as f64).max(cx - half);
+                    let dy = ((y + 1) as f64).min(cy + half) - (y as f64).max(cy - half);
+                    let value = (dx.max(0.) * dy.max(0.) * 255.).round() as u8;
+                    pixels[(y * width + x) * 3..(y * width + x) * 3 + 3].fill(value);
+                }
+            }
+        }
+    }
+    Some(pixels)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn geometry_stays_one_to_two_at_every_size_and_offset() {
+        for advance in [0.1, 6.9, 7., 7.5, 14.4, 24.9] {
+            for x in [-2, 0, 3] {
+                for y in [-1, 0, 4] {
+                    let width = (advance + f64::from(x)).floor().max(1.);
+                    assert_eq!(cell_height(advance, x, y) + f64::from(y), width * 2.);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn all_masks_use_correct_unicode_dot_positions() {
+        let bit_at = [[0, 1, 2, 6], [3, 4, 5, 7]];
+        for mask in 0..256u32 {
+            let pixels = rasterize(char::from_u32(0x2800 + mask).unwrap(), 12, 24).unwrap();
+            for (column, rows) in bit_at.iter().enumerate() {
+                for (row, bit) in rows.iter().enumerate() {
+                    let center = ((row * 6 + 3) * 12 + column * 6 + 3) * 3;
+                    assert_eq!(pixels[center], if mask & (1 << bit) != 0 { 255 } else { 0 });
+                }
+            }
+            assert_eq!(
+                pixels.iter().filter(|&&v| v > 0).count(),
+                mask.count_ones() as usize * 16 * 3
+            );
+        }
+        assert!(rasterize('A', 12, 24).is_none());
+        assert!(rasterize('\u{2900}', 12, 24).is_none());
+    }
+
+    #[test]
+    fn odd_and_retina_sizes_have_symmetric_uniform_dots() {
+        for width in 1..33 {
+            let height = width * 2;
+            let pixels = rasterize('\u{28ff}', width, height).unwrap();
+            assert_eq!(pixels.len(), width * height * 3);
+            for y in 0..height {
+                for x in 0..width {
+                    let at = |x, y| pixels[(y * width + x) * 3];
+                    assert_eq!(at(x, y), at(width - 1 - x, height - 1 - y));
+                    assert_eq!(at(x, y), at(x, (y + width) % height));
+                }
+            }
+        }
+    }
+}
