+        parser.advance(&mut term, b"\x1b[?1003h\x1b]22;pointer\x1b\\");
+        assert_eq!(term.mouse_cursor_icon(), Some(CursorIcon::Pointer));
+        parser.advance(&mut term, b"\x1b]22;default\x07");
+        assert_eq!(term.mouse_cursor_icon(), Some(CursorIcon::Default));
+        parser.advance(&mut term, b"\x1b]22;pointer\x07\x1b[?1003l");
+        assert_eq!(term.mouse_cursor_icon(), None);
+        parser.advance(&mut term, b"\x1b[?1003h");
+        term.mode.insert(TermMode::VI);
+        assert_eq!(term.mouse_cursor_icon(), None);
+        term.mode.remove(TermMode::VI);
+        parser.advance(&mut term, b"\x1bc\x1b[?1003h");
+        assert_eq!(term.mouse_cursor_icon(), None);
+        parser.advance(&mut term, b"\x1b]22;pointer\x07");
+        term.set_options(Config::default());
+        assert_eq!(term.mouse_cursor_icon(), None);
+        term.set_options(config);
+        assert_eq!(term.mouse_cursor_icon(), None);
+    }
