    <EmbeddedResource Include="Localization\ru.json" LogicalName="NaviDnD.Localization.ru.json" />
    <EmbeddedResource Include="Localization\ru.plurals.json" LogicalName="NaviDnD.Localization.ru.plurals.json" />
  </ItemGroup>

</Project>
