<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../NaviDnD/dnd.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Language of the window and messages: general L from the game, translation - only installer lines (ru.json nearby) for edits
       The game text was not rebuilt by the installer. -->
  <ItemGroup>
    <Compile Include="../NaviDnD.Data/L.cs" Link="L.cs" />
    <EmbeddedResource Include="ru.json" LogicalName="NaviDnD.Localization.ru.json" />
  </ItemGroup>
</Project>
